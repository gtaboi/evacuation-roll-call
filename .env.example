# Copy to .env and fill in, then run: node tools/env-to-config.mjs
# Only browser-safe values belong here: they end up in config.js, which every visitor downloads.
# Never put the Supabase service_role key or database password in this file.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Optional: Google Maps browser key restricted to the site's address
GOOGLE_MAPS_API_KEY=
