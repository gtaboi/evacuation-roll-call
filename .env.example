# Copy to .env and fill in, then run: node tools/env-to-config.mjs
# The SUPABASE_* and GOOGLE_MAPS_* values end up in config.js, which every visitor downloads, so only
# browser-safe keys go there. LLM_* values are never copied into config.js.
# Never put the Supabase service_role key or database password in this file.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Optional: Google Maps browser key restricted to the site's address
GOOGLE_MAPS_API_KEY=

# Optional LLM (server-side only; not used by the browser). OpenCode Go is OpenAI-compatible;
# requests also need an x-opencode-session header (a stable ID per conversation).
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
